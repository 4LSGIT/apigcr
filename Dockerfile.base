# Dockerfile.base — the heavy, slow-changing half of the runtime image.
#
# WHY THIS FILE EXISTS (2026-08-30)
#   Chromium is a ~800 MB layer. Cloud Build's source-deploy path keeps no
#   persistent layer cache between builds, so when this apt step lived in the
#   main Dockerfile it was rebuilt and re-pushed as a FRESH BLOB on every
#   deploy. At ~5 deploys/day that added ~4 GiB/day to Artifact Registry —
#   measured 4.1 GiB/day, taking the repo to 150 GiB and $14.94/mo on a
#   trajectory to ~$182/mo within a year.
#
#   Splitting it out means the layer is built and pushed ONCE. App deploys
#   then push only the npm + source layers (~50-150 MB) and finish faster.
#
# NOTE THE REPOSITORY. This image lives in its OWN Artifact Registry repo
# (svpcac-base), NOT in cloud-run-source-deploy. That is deliberate: the
# cleanup policy on cloud-run-source-deploy deletes anything older than 7d,
# and a base image is by design old. Keeping it in a separate repo with no
# cleanup policy means the two can never interact. Create it once with:
#
#   gcloud artifacts repositories create svpcac-base \
#     --repository-format=docker --location=us-east1 \
#     --description="Base image for svpcac (node+chromium). No cleanup policy."
#
# BUILD AND PUSH (only when node or chromium needs a security refresh —
# put a monthly reminder on it). `gcloud builds submit --tag` requires the
# Dockerfile to be named `Dockerfile` in the build context, so stage it:
#
#   rm -rf /tmp/svpcac-base && mkdir -p /tmp/svpcac-base
#   cp Dockerfile.base /tmp/svpcac-base/Dockerfile
#   gcloud builds submit /tmp/svpcac-base \
#     --tag us-east1-docker.pkg.dev/lsg-api-425223/svpcac-base/base:1
#
# VERIFY before deploying the app against it:
#   docker run --rm us-east1-docker.pkg.dev/lsg-api-425223/svpcac-base/base:1 \
#     sh -c 'node -v && /usr/bin/chromium --version'
#
# BUMP THE TAG (:2, :3, ...) rather than overwriting :1, so a rebuilt base can
# never silently change what an already-deployed revision rebuilds from.
# Update the FROM line in Dockerfile in the same commit.
FROM node:24-slim

# Chromium for pdfRenderService (Phase 2B: template HTML -> PDF).
# apt chromium, NOT puppeteer's own download -- one binary, managed by the
# base image's debian, resolved at /usr/bin/chromium (pdfRenderService
# falls back through PUPPETEER_EXECUTABLE_PATH and common alternates).
# fonts-liberation + dejavu: metric-compatible Arial/Times/Courier stand-ins
# so contracts don't render in chromium's last-resort fallback font.
RUN apt-get update && apt-get install -y --no-install-recommends \
    chromium fonts-liberation fonts-dejavu-core && \
    rm -rf /var/lib/apt/lists/*
