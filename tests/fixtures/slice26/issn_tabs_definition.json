{
  "note": "issn — Initial Screening intake form (Slice 2.6 tabbed rebuild from public/forms/issn.html, 2026-08-03). stickyTop = case header, stickyBottom = intake notes, six tabs matching the hand-built panels. Contact fields prefill via $load; employment/debt blocks are declarative showWhen includes; Ash Auto is a type:\"embed\" field. Residual behaviours (docket fallback, secondary-client inference defaults, per-row vehicle Lease conditional, contact write-back on save, Calendly name-passing, KBB link) live in the code key. Repeater field names match issn.html verbatim (incl. \"note\" in both repeaters) — the form has existing submissions keyed to those names.",
  "toggle": false,
  "dataMode": "snapshot",
  "autosaveMs": 3000,
  "warningText": "",
  "endpoints": {
    "load": {
      "url": "/api/cases/{linkId}?include=clients",
      "method": "GET",
      "path": "case"
    }
  },
  "css": ".yc-check-grid[data-yc-checkgroup=\"debt_type\"]{grid-template-columns:repeat(4,1fr);}",
  "code": "/*\n * issn (template 7) per-form code — Slice 2.6. Successor to\n * /forms/hooks/issn_extras.js (file deleted from the repo; this code lives in\n * the definition, restorable from template history / git history).\n *\n * Everything Slice 2.5/2.6 made declarative has MOVED OUT of here:\n *   - PC/SC contact field fills + marital status  → $load prefills\n *   - checkgroup-driven employment/debt blocks    → showWhen op:\"includes\"\n *   - five tabs + Ash Auto Calendly iframe        → tabs + type:\"embed\" (2.6)\n *\n * Still here — the behaviours with no schema representation:\n *   1. case_number full||short fallback (one prefill per field; the OR is\n *      inexpressible declaratively).\n *   2. Secondary-client inference defaults: a Secondary client on the case\n *      implies married + co-debtor unless the user already said otherwise.\n *   3. Per-row vehicle conditional (ownership === 'Lease' shows lease_end_date\n *      and hides total_owed) — showWhen inside repeaters is out of scope.\n *   4. Contact write-back on save — second-entity writes are a workflow\n *      decision, not a schema feature (contract §9).\n *   5. APPROVED ADDITIONS (2026-08-03, beyond the locked 2.6 residue list;\n *      both are issn.html behaviours the schema cannot express — delimited\n *      blocks below, trivially removable):\n *      5a. Calendly name-passing: appends ?name=<client_name> to the embed src.\n *      5b. KBB link injected after the vehicles repeater's add button.\n */\n(function () {\n  'use strict';\n\n  var UTIL = '/forms/hooks/_yc_hook_util.js';\n  function loadUtil() {\n    if (window.ycHookUtil) return Promise.resolve(window.ycHookUtil);\n    if (window.__ycUtilPromise) return window.__ycUtilPromise;\n    window.__ycUtilPromise = new Promise(function (resolve) {\n      var s = document.createElement('script');\n      s.src = UTIL;\n      s.onload = function () { resolve(window.ycHookUtil); };\n      s.onerror = function () { console.warn('[issn code] util failed to load'); resolve(null); };\n      document.head.appendChild(s);\n    });\n    return window.__ycUtilPromise;\n  }\n\n  window.ycHooks = {\n    async onLoad(form) {\n      var U = await loadUtil();\n      if (!U) return;\n      var e = U.entity(form);\n      var c = U.clients(form);\n\n      // ── 1. docket: full form preferred, short-form fallback ─────────────\n      U.setIfEmpty(form, 'case_number', e.case_number_full || e.case_number);\n\n      // ── 2. inference defaults ───────────────────────────────────────────\n      if (c.secondary) {\n        U.setRadioIfEmpty(form, 'marital_status', 'Married');\n        U.setRadioIfEmpty(form, 'is_codebtor', 'Yes');\n      }\n\n      // ── 3. per-row vehicle conditional ──────────────────────────────────\n      var veh = document.getElementById('ycRep_vehicles');\n      if (veh) {\n        var applyRow = function (item) {\n          var sel = item.querySelector('[name=\"ownership\"]');\n          if (!sel) return;\n          var isLease = sel.value === 'Lease';\n          var lease = item.querySelector('[name=\"lease_end_date\"]');\n          var owed = item.querySelector('[name=\"total_owed\"]');\n          if (lease && lease.closest('.yc-field')) lease.closest('.yc-field').style.display = isLease ? '' : 'none';\n          if (owed && owed.closest('.yc-field')) owed.closest('.yc-field').style.display = isLease ? 'none' : '';\n        };\n        veh.addEventListener('change', function (ev) {\n          if (!ev.target.matches('[name=\"ownership\"]')) return;\n          var item = ev.target.closest('.yc-repeater-item');\n          if (item) applyRow(item);\n        });\n        // Rows added later by the Add button also need it. MutationObserver\n        // rather than patching addRepeaterItem, so nothing in yc-forms is touched.\n        new MutationObserver(function (muts) {\n          muts.forEach(function (m) {\n            Array.prototype.forEach.call(m.addedNodes, function (n) {\n              if (n.nodeType === 1 && n.classList.contains('yc-repeater-item')) applyRow(n);\n            });\n          });\n        }).observe(veh, { childList: true });\n        veh.querySelectorAll('.yc-repeater-item').forEach(applyRow);\n      }\n\n      // ── 5a. Calendly name-passing (approved addition — removable) ───────\n      var nameEl = form.el.querySelector('[name=\"client_name\"]');\n      var frame = form.el.querySelector('[data-yc-embed=\"ash_auto\"]');\n      if (nameEl && nameEl.value && frame && frame.getAttribute('src')) {\n        try {\n          var calUrl = new URL(frame.getAttribute('src'));\n          calUrl.searchParams.set('name', nameEl.value);\n          frame.setAttribute('src', calUrl.toString());\n        } catch (err) { /* invalid URL, skip */ }\n      }\n      // ── end 5a ──\n\n      // ── 5b. KBB link after the vehicles repeater (approved addition — removable) ──\n      if (veh && !document.getElementById('issnKbbLink')) {\n        var vehSec = veh.closest('.yc-section');\n        var addBtn = vehSec ? vehSec.querySelector('.yc-repeater-add') : null;\n        var kbb = document.createElement('a');\n        kbb.id = 'issnKbbLink';\n        kbb.href = 'https://www.kbb.com/whats-my-car-worth/';\n        kbb.target = '_blank';\n        kbb.rel = 'noopener';\n        kbb.textContent = \"KBB — What's My Car Worth?\";\n        kbb.setAttribute('style', 'display:inline-block;margin-top:8px;padding:6px 14px;background:#0d6efd;color:#fff;border-radius:4px;text-decoration:none;font-size:0.85rem;font-weight:500;');\n        if (addBtn && addBtn.parentNode) addBtn.parentNode.insertBefore(kbb, addBtn.nextSibling);\n        else if (vehSec) vehSec.appendChild(kbb);\n      }\n      // ── end 5b ──\n    },\n\n    // ── 4. contact write-back ─────────────────────────────────────────────\n    async onSave(form) {\n      var U = window.ycHookUtil;\n      if (!U) return;\n      var d = form.collect();\n\n      if (d.client_id) {\n        var pc = {};\n        [['client_fname', 'contact_fname'], ['client_mname', 'contact_mname'],\n         ['client_lname', 'contact_lname'], ['client_phone', 'contact_phone'],\n         ['client_email', 'contact_email'], ['client_dob', 'contact_dob'],\n         ['client_ssn', 'contact_ssn'], ['client_address', 'contact_address'],\n         ['client_city', 'contact_city'], ['client_state', 'contact_state'],\n         ['client_zip', 'contact_zip']].forEach(function (p) {\n          if (d[p[0]]) pc[p[1]] = d[p[0]];\n        });\n        if (Object.keys(pc).length) {\n          U.api('/api/contacts/' + d.client_id, 'PATCH', pc)\n            .catch(function (err) { console.warn('[issn] primary contact update failed:', err); });\n        }\n      }\n\n      if (d.is_codebtor !== 'Yes' || !d.cd_fname) return;\n\n      var cd = { contact_fname: d.cd_fname, contact_lname: d.cd_lname };\n      if (d.cd_mname !== undefined) cd.contact_mname = d.cd_mname;\n      ['phone', 'email', 'dob', 'ssn'].forEach(function (k) {\n        if (d['cd_' + k]) cd['contact_' + k] = d['cd_' + k];\n      });\n      if (d.cd_address_type === 'Same as Debtor') {\n        cd.contact_address = d.client_address; cd.contact_city = d.client_city;\n        cd.contact_state = d.client_state; cd.contact_zip = d.client_zip;\n      } else if (d.cd_address_type === 'Different') {\n        ['address', 'city', 'state', 'zip'].forEach(function (k) {\n          if (d['cd_' + k]) cd['contact_' + k] = d['cd_' + k];\n        });\n      }\n\n      if (d.cd_contact_id) {\n        U.api('/api/contacts/' + d.cd_contact_id, 'PATCH', cd)\n          .catch(function (err) { console.warn('[issn] co-debtor update failed:', err); });\n        return;\n      }\n\n      try {\n        var body = {\n          firstName: d.cd_fname, middleName: d.cd_mname || '', lastName: d.cd_lname,\n          phone: d.cd_phone || '', email: d.cd_email || '',\n        };\n        ['contact_dob', 'contact_ssn', 'contact_address', 'contact_city',\n         'contact_state', 'contact_zip'].forEach(function (k) { if (cd[k]) body[k] = cd[k]; });\n\n        var created = await U.api('/api/intake/contact', 'POST', body);\n        var newId = created && (created.contact_id || created.id);\n        if (!newId) return;\n        await U.api('/api/cases/' + d.case_id + '/contacts', 'POST',\n          { contact_id: newId, relate_type: 'Secondary' });\n        U.setAlways(form, 'cd_contact_id', newId);\n        U.setAlways(form, 'cd_id', newId);\n      } catch (err) {\n        console.warn('[issn] co-debtor create failed:', err);\n      }\n    },\n  };\n})();\n",
  "stickyTop": [
