--- a/ref/migrations/2026-09-25_log_date_timezone_comment.sql	1970-01-01 00:00:00.000000000 +0000
+++ b/ref/migrations/2026-09-25_log_date_timezone_comment.sql	2026-09-24 23:31:42.525000480 +0000
@@ -0,0 +1,36 @@
+-- ref/migrations/2026-09-25_log_date_timezone_comment.sql
+--
+-- Docs review #2 (2026-09-25) — record, on the column itself, that `log.log_date`
+-- has FOUR writers spelling the SAME wall clock THREE different ways. Nothing is
+-- broken today; the COMMENT exists so the next reader does not have to rediscover
+-- that the disagreement is cosmetic, and so a future zone change finds all of it.
+--
+-- WHY: debt key docs/20260925_log_timezone_spellings, verified 2026-09-25 against
+-- ref/database.sql and the live source:
+--
+--   after_contact_update (trigger, ref/database.sql)
+--       CONVERT_TZ(NOW(), 'UTC', 'America/New_York')
+--   services/logService.js:998  (createLogEntry — the app-side writer)
+--       CONVERT_TZ(NOW(), @@session.time_zone, 'EST5EDT')
+--   services/emailIngestService.js:551
+--       CONVERT_TZ(NOW(), @@session.time_zone, 'EST5EDT')
+--   services/intakeService.js:373, :535, :584
+--       CONVERT_TZ(NOW(), 'UTC', 'America/New_York')
+--
+-- while FIRM_TIMEZONE (services/timezoneService.js) is 'America/Detroit'.
+-- All three zones carry the same offset, so every row is correct — but the
+-- three literals live in two languages and a zone change would have to find
+-- all of them. Unification is filed in ref/plans.md; this migration only
+-- documents the state.
+--
+-- LANDMINE, recorded here because it bites clone/harness work: a MySQL
+-- instance with no timezone tables loaded makes CONVERT_TZ() return NULL, and
+-- log_date is NOT NULL — every log write fails. Run mysql_tzinfo_to_sql on any
+-- real-engine clone before pointing this code at it.
+--
+-- SAFE TO RE-RUN. Comment-only: no data, type or nullability change.
+-- Column type confirmed 2026-09-25: datetime NOT NULL, no default, EXTRA ''.
+
+ALTER TABLE `log`
+  MODIFY COLUMN `log_date` datetime NOT NULL
+  COMMENT 'FIRM-LOCAL wall clock, not UTC. Four writers, three spellings of the same offset: after_contact_update trigger + intakeService use CONVERT_TZ(NOW(),UTC,America/New_York); logService.createLogEntry + emailIngestService use CONVERT_TZ(NOW(),@@session.time_zone,EST5EDT); FIRM_TIMEZONE is America/Detroit. Same offset today - see ref/plans.md before changing any of them. A MySQL with no tz tables loaded returns NULL here and this column is NOT NULL.';
